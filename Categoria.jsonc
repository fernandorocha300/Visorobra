{
  "name": "Categoria",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra \u00e0 qual a categoria pertence"
    },
    "nome": {
      "type": "string",
      "description": "Nome da categoria (ex: Di\u00e1rias, Evolu\u00e7\u00e3o da Obra, Seguran\u00e7a, Instala\u00e7\u00f5es)"
    }
  },
  "required": [
    "obra_id",
    "nome"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}