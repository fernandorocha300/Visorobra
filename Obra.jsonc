{
  "name": "Obra",
  "type": "object",
  "properties": {
    "nome_obra": {
      "type": "string",
      "description": "Nome da obra"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o da obra (opcional)"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio da obra"
    },
    "status": {
      "type": "string",
      "description": "Status da obra",
      "enum": [
        "EM_ANDAMENTO",
        "CONCLUIDA"
      ],
      "default": "EM_ANDAMENTO"
    }
  },
  "required": [
    "nome_obra",
    "data_inicio"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}